{
  "name": "@cda/adapter-xma",
  "version": "0.0.0-development",
  "description": "XMA output adapter for the Continuous-Driven Architecture (CDA) ecosystem. Serializes the ArchiModel produced by @cda/archi-semantic-core into an XMA document.",
  "keywords": [
    "archimate",
    "xma",
    "enterprise-architecture",
    "cda",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.esm.json && tsc -p tsconfig.build.cjs.json && node scripts/write-cjs-package-json.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@cda/archi-semantic-core": "^0.5.0"
  },
  "devDependencies": {
    "@cda/archi-semantic-core": "^0.5.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.8.1",
    "fast-xml-parser": "^5.10.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Continuous-DrivenArchitecture/adapter-xma.git"
  },
  "homepage": "https://github.com/Continuous-DrivenArchitecture/adapter-xma#readme",
  "bugs": {
    "url": "https://github.com/Continuous-DrivenArchitecture/adapter-xma/issues"
  }
}
