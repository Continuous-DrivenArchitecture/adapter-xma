<ArchiMate:MotivationRequirement id="97">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Regelmatig Bijstellen van Gedrag</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationAssessment id="98">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Regelmatig Terugkijken</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationAssessment>
<ArchiMate:MotivationRequirement id="99">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Neem gemotiveerde individueen aan, of ontwikkel hun motivatie</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationDriver id="100">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Agility / Wendbaarheid</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationRequirement id="101">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Vertrouw hen</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationDriver id="102">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Onnodig Werk Wordt Niet Gedaan</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationRequirement id="103">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Face-to-face communicatie</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationAssessment id="104">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Werkende Software</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationAssessment>
<ArchiMate:MotivationRequirement id="105">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Agile Processen</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationAssessment id="106">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Continue Aandacht</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationAssessment>
<ArchiMate:MotivationRequirement id="107">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Het niveau van ondersteuning moet kloppen met de behoefte van de ontwikkelaars</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationDriver id="108">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Eenvoud</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="109">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Efficiënte en Effectieve informatie Stromen</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="110">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Noodzakelijk Werk Gedaan</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="111">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Beste Architectuur, Vereisten en Ontwerp</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="112">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Meer Effectief Team</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationRequirement id="113">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Zelforganiserende Teams</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationValue id="18">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Waarde</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationValue>
<ArchiMate:MotivationPrinciple id="114">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">1. Onze hoogste prioriteit is het tevredenstellen van de klantdoor het vroegtijdig en voortdurend opleveren van waardevolle software.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="115">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">3. Lever regelmatig werkende software op. Liefst iedere paar weken tot hooguit iedere paar maanden.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="116">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2. Verwelkom veranderende behoeftes,zelfs laat in het ontwikkelproces.Agile processen benutten veranderingtot concurrentievoordeel van de klant.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationRequirement id="117">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Samenwerking gedurende het gehele project</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationMeaning id="118">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Zelfs laat in het ontwikkelproces</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationMeaning>
<ArchiMate:MotivationMeaning id="119">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Enkele weken, maximaal een paar maanden</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationMeaning>
<ArchiMate:MotivationPrinciple id="120">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7. Werkende software is de belangrijkste maat voor voortgang.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="121">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">9. Voortdurende aandacht voor een hoge technische kwaliteiten voor een goed ontwerp versterken agility.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationDriver id="122">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Concurrentievermogen van de klant</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="123">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Waardevolle Software</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="124">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Frequent Opleveren</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="125">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Continu Opleveren</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationMeaning id="126">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Korte tijdshorizon heeft de voorkeur</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationMeaning>
<ArchiMate:MotivationDriver id="127">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Business en Ontwikkeling werken samen</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="128">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Klant Tevredenheid</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="129">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Verwelkom veranderende vereisten</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationPrinciple id="130">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">4. Mensen uit de business en ontwikkelaars moeten dagelijks samenwerkengedurende het gehele project.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationMeaning id="131">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Het gaat enkel om Prioriteit</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationMeaning>
<ArchiMate:MotivationPrinciple id="132">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">10. Eenvoud, de kunst van het maximaliserenvan het werk dat niet gedaan wordt, is essentieel.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="133">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">11. De beste architecturen, eisen en ontwerpenkomen voort uit zelforganiserende teams.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationDriver id="134">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Werkende Software</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationPrinciple id="135">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6. De meest efficiënte en effectieve manier om informatie te delenin en met een ontwikkelteam is door met elkaar te praten.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationDriver id="136">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Vroegtijdig Opleveren</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="137">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Klus geklaard</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationDriver id="138">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Agile Processen Verwelkomen Verandering</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationDriver>
<ArchiMate:MotivationPrinciple id="139">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8. Agile processen bevorderen constante ontwikkeling.De opdrachtgevers, ontwikkelaars en gebruikersmoeten een constant tempo eeuwig kunnen volhouden.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationRequirement id="140">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Dagelijks Samenwerken</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationPrinciple id="141">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5.Bouw projecten rond gemotiveerde individuen.Geef hen de omgeving en ondersteuning die ze nodig hebbenen vertrouw erop dat ze de klus klaren.</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="142">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">12. Op vaste tijden, onderzoekt het teamhoe het effectiever kan wordenen past vervolgens zijn gedrag daarop aan.</MM_Value>
