</ArchiMate:MotivationScheme>
<ArchiMate:MotivationScheme id="2703">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">4_Operational_Attributes</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Thee attributes describe the ease and effectiveness with which the business system and its services can be operated.}</MM_Value>
</MM_ProfileValues>
<ArchiMate:MotivationStakeholders name="stakeholders" id="2704"/>
<ArchiMate:MotivationElements name="motivations" id="2705">
<ArchiMate:MotivationPrinciple id="1349">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">4_04_Error-Free</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should operate without producing errors.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1354">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">4_07_Productive</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system and its services should operate so as to sustain and enhance productivity of the users, with regard to the business processes in which they are engaged.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1356">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">4_06_Monitored</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The operational performance of the system should be continuously monitored to ensure that other attribute specifications are being mets. Any deviations from acceptable limits should be notified to the systems management function.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1351">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">4_02_Continuous</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should offer &quot;continuous service.&quot; The exact definition of this phrase will always be subject to a SLA.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1360">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">4_05_Interoperable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should interoperate with other similar systems, both immediately and in the future, as intersystem communication becomes increasingly a requirement.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1358">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">4_03_Detectable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Important events must be detected and reported}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="697">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">4_08_Recoverable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be able to be recovered to full operational status after a breakdown or disaster, in accordance with the SLA.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="72">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">4_01_Available</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The information and services provided by the system should be available according to the requirements specified in the service-level agreement (SLA)}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
</ArchiMate:MotivationElements>
