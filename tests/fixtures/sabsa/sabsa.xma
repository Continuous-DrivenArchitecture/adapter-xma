<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Figure27</MM_Value>
</MM_ProfileValues>
<ArchiMate:MotivationStakeholders name="stakeholders" id="2539"/>
<ArchiMate:MotivationElements name="motivations" id="2540">
<ArchiMate:MotivationRequirement id="1564">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Establish Eligibility to Consent</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationRequirement id="1554">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Clear Written Communication</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 All communication with the data subject's must be in writing in a concise, transparent intelligible and easily accessible form, using clear and plain language.\par \par The appropriateness of communication is particularly important for any information specifically to a child.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationGoal id="1548">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Establish Data Subject's Consent</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The data subject has given consent to the processing of his or her personal data for one or more specific purposes.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationGoal>
<ArchiMate:MotivationRequirement id="1556">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Demonstrate Data Subject's Consent</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The Controller shall be able to demonstrate that the Data Subject has consented to processing of his or her personal data.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationPrinciple id="1546">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7: Conditions for Consent</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 1. Where processing is based on consent.\par \par 2. If the data subject's consent is given in the context of a written declaration which also concerns other matters, the request for consent shall be presented in a manner which is clearly distinguishable from the other matters, in an intelligible and easily accessible form, using clear and plain language. Any part of such a declaration which constitutes an infringement of this Regulation shall not be binding.\par \par 3. The data subject shall have the right to withdraw his or her consent at any time. The withdrawal of consent shall not affect the lawfulness of processing based on consent before its withdrawal. Prior to giving consent, the data subject shall be informed thereof. It shall be as easy to withdraw as to give consent.\par \par 4. When assessing whether consent is freely given, utmost account shall be taken of whether, inter aka, the performance of a contract, including the provision of a service, is conditional on consent to the processing of personal data that is not necessary for the performance of the contract.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationRequirement id="1552">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Ability to Withdraw Consent</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationRequirement id="1568">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Freely-Given Consent</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
<ArchiMate:MotivationRequirement id="1550">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">Authenticated Oral Communication</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationRequirement>
</ArchiMate:MotivationElements>
