<ArchiMate:MotivationScheme id="2647">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_User_Attributes</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 These attributes are related to the user's experience of interacting with the business system.}</MM_Value>
</MM_ProfileValues>
<ArchiMate:MotivationStakeholders name="stakeholders" id="2648"/>
<ArchiMate:MotivationElements name="motivations" id="2649">
<ArchiMate:MotivationPrinciple id="1449">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_10_Protected</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The user's information and access privileges should be protected against abuse by other users or by intruders.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1427">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_03_Anonymous</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 For certain specialized types of service, the anonymity of the user should be protected.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1443">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_06_Duty_Segregated</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 For certain sensitive tasks, the detuies should be segregated so that no user has access to both aspects of the task.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1445">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_07_Educated_&amp;_Aware</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The user community should be educated and trained so that they can embrace the security culture.\par \par There should be sufficient user awareness of security issues so that behavior of users is compliant with security policies.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1439">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_11_Reliable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The services provided to the user should be delivered at a reliable level of quality.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1429">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_15_Transparent</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Providing full visibility to the user of the logical process but hiding the physical structure of the system (as a URL hides the actual physical locations of Web servers).}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1441">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_02_Accurate</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The information provided to users should be accurate within a range that has been preagreed upon as being applicable to the service being delivered.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1435">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_12_Responsive</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The users obtain a response within a satisfactory period of time that meets their expectations.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1425">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_05_Current</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Information provided to users should be current and kept up to date, within a range that has been preagreed upon as being applicable for the service being delivered.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1447">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_08_Informed</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The user should be kept fully informed about services, operating procedures, operational schedules, planned outages, and so on.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1421">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_09_Motivated</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The interaction with the system should add positive motivation to the user to complete the business tasks at hand.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1423">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_04_Consistent</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The way in which log-in, navigation, and target services are presented to the user should be consistent across different times, locations, and channels of access.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1433">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_01_Accessible</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Information to which the user is entitled to gain access should be easily found and accessed by that user.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="737">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_13_Supported</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 When a user has problems or difficulties in using the system or its services, there should be a means by which the user can receive advice and support so that the problems can be resolved to the satisfaction of the user.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="739">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_16_Usable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should provide easy-to-use interfaces that can be navigated intuitively by a user of average intelligence and training level (for the given system). The user's experience of these interactions should be as best interesting and at worst neutral.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1437">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">2_14_Timely</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Information is delivered or made accessible to the user at the appropriate time or within the appropriate time period}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
</ArchiMate:MotivationElements>
<ArchiMate:Relations name="relations" id="2650">
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2651" from="1441" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2652" from="1429" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2653" from="1447" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2654" from="1433" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2655" from="1423" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2656" from="1437" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2657" from="739" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2658" from="1443" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2659" from="1421" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2660" from="1425" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2661" from="737" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2662" from="1449" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2663" from="1435" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2664" from="1439" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2665" from="1445" to="1418"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2666" from="1427" to="1418"/>
</ArchiMate:Relations>
</ArchiMate:MotivationScheme>
<ArchiMate:MotivationScheme id="2667">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_Risk_Management_Attributes</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 These attributes describe the business requirements for mitigating operational risk. This group most closely related to the &quot;security requirements&quot; for protecting the business.}</MM_Value>
</MM_ProfileValues>
<ArchiMate:MotivationStakeholders name="stakeholders" id="2668"/>
<ArchiMate:MotivationElements name="motivations" id="2669">
<ArchiMate:MotivationPrinciple id="1337">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_19_Trustworthy</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be able to be trusted to behave in the ways specified in its functional specification and should protect against a wide range of potential abuses.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1322">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_18_Private</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The privacy of (personal) information should be protected in accordance with relevant privacy or &quot;data protection&quot; legislation, so as to meet the reasonable expectation of citizens for privacy. Unauthorized disclosure should be prevented.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1343">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_11_Flexibly_Secure</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Security cna be provided at various levels, according to business need. The system should provide the means to secure information according to these needs, and may need to offer different levels of security for different types of information (according to security classification).}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1316">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_08_Capturing_New_Risks</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 New risks emerge over time.\par \par The system management and operational environment should provide a means to identify and access new risks (new threats, new impacts, or new vulnerabilities).}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1330">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_12_Identified</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Each entity that will be granted access to system resources and each object that is itself a system resource should be uniquely identified (named) such that there can never be confusion as to which entity or object is being referenced.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1314">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_13_Independently_Secure</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The security of the system should not rely upon the security of any other system that is not within the direct span of control of this system.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1135">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_15_Integrity-Assured</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The integrity of information should be protected to provide assurance that is has not suffered unauthorized modification, duplication, or deletion.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1320">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_10_Crime-Free</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Cyber-crime of all types should be prevented.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1340">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_14_In_our_sole_possession</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Information that has value to the business should be in the possession of the business, stored and protected by the system against loss (as in no longer being available) or theft (as in being disclosed to an unauthorised party). This will include information that is regarded as &quot;intellectual property&quot;.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1324">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_17_Owned</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 There should be an entity designated as &quot;owner&quot; of every system. This owner is the policy maker for all aspects of risk management with respect to the system, and exerts the ultimate authority for controlling the system.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1327">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_16_Non-Repudiable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 When on party uses the system to send a message to another party, it should not be possible for the first party to falsely deny having sent the message, or to falsely deny it's contents.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="297">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_09_Confidential</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The confidentiality of (corporate) information should be protected in accordance with security policy. Unauthorized disclosure should be prevented.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1143">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_06_Authenticated</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Every party claiming a unique identity (i.e., a claimant) should be subject to a procedure that verifies that the party is indeed the authentic owner of the claimed identity.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1137">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_05_Auditable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The actions of all parties having authorized access to the system, and the complete chain of events and outcomes resulting from these actions, should be recorded so that this history can be reviewed.\par \par The audit records should provide an appropriate level of detail, in accordance with business needs.\par \par The actual configuration of the system should also be capable of being sudited so as to compare it with a target configuration that represents the implementation of the security policy that governs the system.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1133">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_01_Access Controlled</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Access to information and functions within the system should be controlled in accordance with the authorized privileges of the party requesting the access. Unauthorized access should be prevented.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1332">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_03_Assurable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 There should be a means to provide assurance that the system is operating as expected and that all of the various controls are correctly implemented and operated.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1318">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_02_Accountable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 All parties having authorized access to the system should be held accountable for their actions.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1312">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_04_Assuring_Honesty</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Protecting employees against false accusations of dishonesty or malpractice.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1335">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">5_07_Authorised</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should allow only those actions that have been explicitly authorized.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
</ArchiMate:MotivationElements>
