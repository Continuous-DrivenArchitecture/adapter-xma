<nm>Figure13_SABSA_BusinessAttributes</nm>
<ArchiMate:AbstractSchemes name="schemes" id="2568">
<ArchiMate:MotivationScheme id="2569">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6_Legal_Regulatory_Attributes</MM_Value>
</MM_ProfileValues>
<ArchiMate:MotivationStakeholders name="stakeholders" id="2570"/>
<ArchiMate:MotivationElements name="motivations" id="2571">
<ArchiMate:MotivationPrinciple id="1470">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6_09_Time-bound</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Meeting requirements for maximum or minimum periods of time, for example, a minimum period for records retention or a maximum period within which something must be completed.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1462">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6_02_Compliant</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should comply with all applicable regulations, laws, contracts, policies, and mandatory standards, both internal and external.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1456">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6_01_Admissible</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should provide forensic records (audit trails and so on) that will be deemed to be &quot;admissible&quot; in a court of law, should that evidence ever need to be presented in support of a criminal prosecution or a civil litigation.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1458">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6_08_Resolvable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be designed, implemented and operated in such a way that disputes can be resolved with reasonable ease and without undue impact on time, cost, or other valuable resources.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1454">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6_06_Liability_Managed</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system services should be designed, implemented and operated so as to manage the liability of the organization with regard to errors, fraud, malfunction, and so on. In particular, the responsibilities and liabilities of each party should be clearly defined.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1466">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6_04_Insurable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be risk-managed to enable an insurer to offer reasonable commercial terms for insurance against a standard range of insurable risks.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1464">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6_03_Enforceable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be designed, implemented and operated such that all applicable contracts, policies, regulations, and laws can be enforced by the system.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1460">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6_07_Regulated</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be designed, implemented, and operated in accordance with the requirements of any applicable regulations. These may be general (such as safety regulations) or industry-specific (such as banking regulations).}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1468">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">6_05_Legal</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be designed, implemented, and operated in accordance with the requirements of any applicable legislation.\par \par Examples include data protection laws, laws controlling the use of cryptographic technology, laws controlling insider dealing on the stock market, and laws governing information that is considered racist, seditious, or pornographic.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
</ArchiMate:MotivationElements>
<ArchiMate:Relations name="relations" id="2572">
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2573" from="1460" to="1451"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2574" from="1468" to="1451"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2575" from="1454" to="1451"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2576" from="1458" to="1451"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2577" from="1464" to="1451"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2578" from="1456" to="1451"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2579" from="1470" to="1451"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2580" from="1462" to="1451"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2581" from="1466" to="1451"/>
</ArchiMate:Relations>
</ArchiMate:MotivationScheme>
<ArchiMate:MotivationScheme id="2582">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_Technical_Strategy_Attributes</MM_Value>
</MM_ProfileValues>
<ArchiMate:MotivationStakeholders name="stakeholders" id="2583"/>
<ArchiMate:MotivationElements name="motivations" id="2584">
<ArchiMate:MotivationPrinciple id="1414">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_03_Extendable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be capable of being extended to incorporate new functional modules as required by the business.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1410">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_02_COTS/GOTS</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Wherever possible, the system shoiuld utilize commercial off-the-shelf or government off-the-shelf components, as appropriate.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1416">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_01_Architecturally_Open</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system architecture should, wherever possible, not be locked into specific vendor interface standards and should allow flexibility in the choice of vendors and products, both initially and in the future.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1402">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_10_Simple</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be as simple as possible, since complexity only adds further risk.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1408">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_09_Scalable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be scalable to the size of user community, data storage requirements, processing throughput, and so on that might emerge over the lifetime of the system.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1400">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_05_Future-Proof</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system architecture should be designed as much as possible to accommodate future changes in both business requirements and technical solutions.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1398">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_06_Legacy-Sensitive</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 A new system should be able to work with any legacy systems or databases with which it needs to interoperate or integrate.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1404">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_08_Multisourced</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Critical system components should be obtainable from more than one source, to protect against the risk of the single source of supply and support being withdrawn.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1396">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_04_Flexible/Adaptable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be flexible and adaptable to meet new business requirements as they emerge.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1412">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_07_Migratable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 There should be a feasible, manageable migration path, acceptable to the business users, that moves from an old system to a new one, or from one released version to the next.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1392">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_11_Standards_Compliant</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be designed, implemented and operated to comply with appropriate technical and operational standards.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1406">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_12_Traceable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The development and implementation of system components should be documented so as to provide complete two-way traceability. That is, every implemented component should be justifiable by tracing back to the business requirements that led to its inclusion in the system, and it should be possible to review every business requirement and demonstrate which of the implemented system components are there to meet this requirement.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1394">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">7_13_Upgradeable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be capable of being upgraded with ease to incorporate new releases of hardware and software.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
</ArchiMate:MotivationElements>
<ArchiMate:Relations name="relations" id="2585">
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2586" from="1408" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2587" from="1398" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2588" from="1416" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2589" from="1414" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2590" from="1394" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2591" from="1400" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2592" from="1412" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2593" from="1410" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2594" from="1396" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2595" from="1406" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2596" from="1404" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2597" from="1392" to="1389"/>
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2598" from="1402" to="1389"/>
</ArchiMate:Relations>
</ArchiMate:MotivationScheme>
<ArchiMate:MotivationScheme id="2599">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_Business_Strategy_Attributes</MM_Value>
</MM_ProfileValues>
<ArchiMate:MotivationStakeholders name="stakeholders" id="2600"/>
<ArchiMate:MotivationElements name="motivations" id="2601">
<ArchiMate:MotivationPrinciple id="1285">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_01_Brand_Enhancing</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should help to establish, build, and support the brand of the products or services based upone this system.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1295">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_05_Credible</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should behave in such a way as to safeguard the credibility of the organization.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1287">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_07_Enabling_time-to-market</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system architecture and design should allow new business initiatives to be delivered to the market with minimum delay.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1303">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_08_Governable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should enable the owners and executive managers of the organization to control the business and to discharge their responsibilities for governance.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1305">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_06_Culture-sensitive</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should be designed, built, and operated with due care and attention to cultural issues relating to those who will experience the system in any way. These issues include such matters as religion, gender, race, nationality, language, dress code, social customs, ethics, politics, and the environment. The objective should be to avoid or minimize offence or distress caused to others.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1291">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_10_Providing_Investment_Re-use</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 As much as possible, the system should be designed to reuse previous investments and to ensure that new investments are reusable in the future.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1297">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_02_Business-Enabled</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Enabling the business and fulfilling business objectives should be the primary driver for the system design.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1307">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_04_Confident</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should behave in such a way as to safeguard confidence placed in the organization by customers, suppliers, shareholders, regulators, financiers, the marketplace, and the general public.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1293">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_11_Providing_Return_on_Investment</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should provide a return of value to the business to justify the investment made in creating and operating the system.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1289">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_09_Providing_Good_Stewardship_and_Custody</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 Protecting other parties with whom we do business from abuse, loss of business, or personal information of value to those parties through inadequate stewardship on our part.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1301">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_03_Competent</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should protect the reputation of the organization as being competent in its industry sector.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
<ArchiMate:MotivationPrinciple id="1299">
<MM_ProfileValues>
<MM_Value name="nm" type="string" xml:lang="en">8_12_Reputable</MM_Value>
<MM_Value name="doc" type="rtf" xml:lang="en">{\rtf1 The system should behave in such a way as to safeguard the business reputation of the organization.}</MM_Value>
</MM_ProfileValues>
</ArchiMate:MotivationPrinciple>
</ArchiMate:MotivationElements>
<ArchiMate:Relations name="relations" id="2602">
<ArchiMate:MotivationPrincipleMotivationPrincipleSpecialization id="2603" from="1287" to="1282"/>
